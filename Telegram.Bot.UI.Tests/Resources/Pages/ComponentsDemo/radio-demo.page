<view id="radio-demo" web-preview="false" back-title="« Back">
    <title>Radio Demo</title>

    <message>
        <b>Radio Component</b>
        <br/><br/>
        Select one option from a group.
        <br/>
        Selected: <b>{{ selectedOption }}</b>
    </message>

    <components>
        <!-- Basic radio group -->
        <radio id="colors" v-bind-selected="selectedOption">
            <option value="red" title="🔴 Red" />
            <option value="green" title="🟢 Green" />
            <option value="blue" title="🔵 Blue" />
        </radio>

        <!-- Radio with icons -->
        <radio id="sizes">
            <option value="small" title="S" />
            <option value="medium" title="M" />
            <option value="large" title="L" />
            <option value="xlarge" title="XL" />
        </radio>

        <!-- Horizontal radio (2 columns) -->
        <radio id="yesno" columns="2">
            <option value="yes" title="👍 Yes" />
            <option value="no" title="👎 No" />
        </radio>
    </components>

    <script>
        var selectedOption = 'red';

        onMounted(function() {
            component('colors').onUpdate = function(e) {
                selectedOption = e.selectedId;
            };
        });
    </script>
</view>
