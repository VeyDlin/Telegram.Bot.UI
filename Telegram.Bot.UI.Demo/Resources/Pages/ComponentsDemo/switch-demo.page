<view id="switch-demo" web-preview="false" back-title="« Back">
    <title>Switch Demo</title>

    <message>
        <b>Switch Component (Carousel)</b>
        <br/><br/>
        A carousel that cycles through options on click.
        <br/>
        For simple ON/OFF, use checkbox instead.
    </message>

    <components>
        <!-- Theme switch - cycles through themes -->
        <switch id="theme" title="Theme: {{ self.title }}">
            <option value="light" title="☀️ Light" />
            <option value="dark" title="🌙 Dark" />
            <option value="auto" title="🔄 Auto" />
        </switch>

        <!-- Quality switch - cycles through quality levels -->
        <switch id="quality" title="Quality: {{ self.title }}">
            <option value="low" title="Low" />
            <option value="medium" title="Medium" />
            <option value="high" title="High" />
            <option value="ultra" title="Ultra" />
        </switch>

        <!-- Language switch -->
        <switch id="language" title="{{ self.title }}">
            <option value="en" title="🇺🇸 English" />
            <option value="ru" title="🇷🇺 Russian" />
            <option value="de" title="🇩🇪 Deutsch" />
        </switch>

        <!-- Status switch with index display -->
        <switch id="status" title="Status {{ self.index + 1 }}/{{ self.count }}: {{ self.title }}">
            <option value="idle" title="⏸️ Idle" />
            <option value="running" title="▶️ Running" />
            <option value="paused" title="⏯️ Paused" />
            <option value="stopped" title="⏹️ Stopped" />
        </switch>
    </components>

    <script>
        onMounted(function() {
            // Initialize theme to dark
            component('theme').cycleTo('dark');
        });
    </script>
</view>
